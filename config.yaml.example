app:
  shutdown_gracetime: 10s
  http_port: 41220
  external_host: localhost
  singbox_log_level: warn
  log_level: info
  disable_docs: false
  secure_cookies: false  # set true behind HTTPS reverse proxy
  pprof_enabled: false
  pprof_bind: 127.0.0.1:6060
  cors:
    allowed_origins: []
  country_lookup:
    check_interval: 30s
    batch_size: 50
    retry_delay: 10m
    provider_timeout: 10s
jwt:
  secret: CHANGE_ME_IN_PRODUCTION
  expiry: 24h0m0s
database: ./outless.db
